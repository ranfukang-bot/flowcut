{
  "name": "flowcut-desktop-workbench",
  "version": "1.4.11",
  "description": "FlowCut 全自动 AI 视频桌面工作台",
  "main": "dist-protected/bootstrap.cjs",
  "author": "Codex",
  "license": "UNLICENSED",
  "scripts": {
    "start": "npm --prefix .. run build && node scripts/harden-site-build.cjs && node scripts/build-protected.cjs && electron .",
    "check": "node --check src/main.js && node --check src/preload-ui.js && node --check src/gemini-preload.js && node --check src/gemini-preload-bridge.js && node --check src/gemini-file-chooser.js && node --check src/gemini-worker-activation.js && node --check src/store.js && node --check src/bridge-engine.js && node --check src/license-client.js && node --check src/update-manager.js && node --check src/seedance-runtime.js && node --check src/renderer.js",
    "test": "node --test tests/*.test.js",
    "build:protected": "node scripts/build-protected.cjs",
    "build:win": "npm --prefix .. run build && node scripts/harden-site-build.cjs && node scripts/build-protected.cjs && node scripts/prepare-runtime.cjs && electron-builder --win nsis portable",
    "build:runtime": "node scripts/prepare-runtime.cjs"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.1",
    "source-map": "^0.6.1"
  },
  "build": {
    "appId": "local.flowcut.ai.video.workbench",
    "productName": "FlowCut全自动AI视频工作台",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-protected/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-protected/site-runtime-host.cjs",
        "to": "site-runtime-host.cjs"
      },
      {
        "from": "build/flowcut-icon.ico",
        "to": "flowcut-icon.ico"
      },
      {
        "from": "..",
        "to": "flowcut-site",
        "filter": [
          "dist/**/*"
        ]
      },
      {
        "from": "runtime-deps/node_modules",
        "to": "flowcut-site/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../vendor/publisher",
        "to": "publisher",
        "filter": [
          "src/**/*",
          "public/**/*",
          "config/settings.example.json",
          "package.json",
          "node_modules/**/*"
        ]
      },
      {
        "from": "integrations/fastmoss-picker",
        "to": "fastmoss-picker"
      },
      {
        "from": "../vendor/publisher/node_modules",
        "to": "publisher/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/flowcut-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-安装版-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-免安装版-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "bytenode": "^1.6.0"
  }
}
